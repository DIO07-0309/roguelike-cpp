// G10.7-B1: Windows resource — game icon + version info
// NOTE: windres resolves relative paths from THIS file's directory (src/)
#include <windows.h>

IDI_ICON1 ICON "../assets/brand/roguelike.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,1,0
 PRODUCTVERSION 1,3,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "Abyssal Echo - Roguelike"
            VALUE "InternalName", "roguelike_cpp"
            VALUE "OriginalFilename", "roguelike_cpp.exe"
            VALUE "ProductName", "Abyssal Echo (回响深渊)"
            VALUE "FileVersion", "1.3.2"
            VALUE "ProductVersion", "1.3.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
